<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Archetype Created Web Application</display-name>
  <servlet>
  	<servlet-name>DBConnection</servlet-name>
  	<display-name>DBConnection</display-name>
  	<description></description>
  	<servlet-class>com.pahana.dao.DBConnection</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>Product</servlet-name>
  	<display-name>Product</display-name>
  	<description></description>
  	<servlet-class>com.pahana.model.Product</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>ProductService</servlet-name>
  	<display-name>ProductService</display-name>
  	<description></description>
  	<servlet-class>com.pahana.service.ProductService</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>DBConnectionFactory</servlet-name>
  	<display-name>DBConnectionFactory</display-name>
  	<description></description>
  	<servlet-class>com.pahana.dao.DBConnectionFactory</servlet-class>
  </servlet>
  <servlet-mapping>
  	<servlet-name>DBConnection</servlet-name>
  	<url-pattern>/DBConnection</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>Product</servlet-name>
  	<url-pattern>/Product</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>ProductService</servlet-name>
  	<url-pattern>/ProductService</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>DBConnectionFactory</servlet-name>
  	<url-pattern>/DBConnectionFactory</url-pattern>
  </servlet-mapping>
</web-app>
